# dev: local libSQL file — no token needed. prod (Vercel): libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./local.db
# only needed for remote prod:
# TURSO_AUTH_TOKEN=

# better-auth signing secret — required in production (throws without it);
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# optional (dev default http://localhost:3000); set in prod for stable callbacks
BETTER_AUTH_URL=

# Email delivery (signup verification + password reset share this sender):
# - without RESEND_API_KEY nothing is emailed; links print to the server
#   console instead (dev mode) — check the terminal, not the inbox.
# - in prod set RESEND_API_KEY and a RESEND_FROM address on your verified
#   Resend domain, otherwise Resend rejects the send (watch server logs for
#   "[auth] Resend rejected…").
# RESEND_API_KEY=
# RESEND_FROM="دفتر هزینه <no-reply@example.com>"
