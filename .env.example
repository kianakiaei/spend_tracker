# dev: local libSQL file — no token needed. prod (Vercel): libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./local.db
# only needed for remote prod:
# TURSO_AUTH_TOKEN=

# better-auth signing secret — required in production (throws without it);
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# optional (dev default http://localhost:3000); set in prod for stable callbacks
BETTER_AUTH_URL=
